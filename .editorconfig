root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.d]
max_line_length = 120
# dfmt settings (dfmt reads them from this file)
dfmt_brace_style = allman
dfmt_soft_max_line_length = 100
dfmt_space_after_cast = true
dfmt_split_operator_at_line_end = false
dfmt_keep_line_breaks = true

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
