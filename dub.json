{
    "name": "clickhoused",
    "description": "Native ClickHouse client for D: pure-D native TCP protocol, blocking (Phobos) and fiber (vibe.d) I/O",
    "authors": [
        "Vadim Lopatin"
    ],
    "copyright": "Copyright © 2026, Vadim Lopatin",
    "license": "BSL-1.0",
    "homepage": "https://github.com/buggins/clickhoused",
    "targetType": "library",
    "toolchainRequirements": {
        "frontend": ">=2.097"
    },
    "libs-windows": [
        "crypt32"
    ],
    "dependencies": {
        "vibe-core": {
            "version": ">=1.22.0 <3.0.0",
            "optional": true
        }
    },
    "subPackages": [
        "./integration-tests",
        "./integration-tests-phobos",
        "./integration-tests-vibe",
        "./integration-tests-vibe1",
        "./examples/basic",
        "./examples/vibe",
        "./bench"
    ],
    "buildTypes": {
        "docs": {
            "buildOptions": [
                "syntaxOnly"
            ],
            "dflags": [
                "-Dddocs",
                "-oq"
            ]
        }
    },
    "configurations": [
        {
            "name": "library"
        },
        {
            "name": "zstd",
            "versions": [
                "ClickHousedZstd"
            ],
            "libs": [
                "zstd"
            ]
        }
    ]
}
