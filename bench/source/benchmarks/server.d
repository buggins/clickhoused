/++
Server benchmarks: SELECT, INSERT and round trips against a real server,
given by `CLICKHOUSE_HOST` (`host` or `host:port`; also `CLICKHOUSE_USER`,
`CLICKHOUSE_PASSWORD`). Use a release build of the server: timings include its
work and the network. Tables are created in the database `clickhoused_bench`.

Copyright: Copyright © 2026, Vadim Lopatin
License:   $(LINK2 https://www.boost.org/LICENSE_1_0.txt, Boost License 1.0).
+/
module benchmarks.server;

import std.datetime.systime : SysTime;

import clickhoused;
import clickhoused.compress.frame : Compression, zstdAvailable;

import benchmarks.api : Row, rowSpecs;
import benchmarks.offline : makeBlocks;
import benchmarks.runner : BenchCase, Prepared;

/// Options for a connection to the benchmark server, or `null` host if `CLICKHOUSE_HOST` is not set.
ConnectionOptions serverOptions(Compression compression = Compression.none)
{
    import std.process : environment;

    const host = environment.get("CLICKHOUSE_HOST", "");
    if (host.length == 0)
        throw new ClientException("The server suite needs CLICKHOUSE_HOST (host or host:port)");
    auto options = ConnectionOptions.fromDsn("clickhouse://" ~ host);
    options.user = environment.get("CLICKHOUSE_USER", "default");
    options.password = environment.get("CLICKHOUSE_PASSWORD", "");
    options.compression = compression;
    return options;
}

private __gshared double sink; // keeps results alive

/// The mixed-column query: the columns of `Row`, generated by the server.
private string mixedQuery(size_t rows)
{
    import std.conv : to;

    return "SELECT number AS id, toString(number) AS name, number / 7 AS value, "
        ~ "toDateTime64(1600000000 + number, 3, 'UTC') AS ts FROM numbers(" ~ rows.to!string ~ ")";
}

/// A query of `rows` numbers.
private string numbers(size_t rows)
{
    import std.conv : to;

    return "SELECT number FROM numbers(" ~ rows.to!string ~ ")";
}

/// The server cases.
BenchCase[] serverCases()
{
    import std.conv : to;

    BenchCase[] cases;

    // SELECT `sql(rows)` on a connection with `compression`, read by `consume`
    Prepared delegate(size_t) selectCase(string function(size_t) sql, void delegate(Connection, string) consume,
            Compression compression = Compression.none)
    {
        Prepared prepare(size_t rows)
        {
            auto conn = new Connection(serverOptions(compression));
            const query = sql(rows);
            void run()
            {
                consume(conn, query);
            }

            return Prepared(rows, 0, &run);
        }

        return &prepare;
    }

    void drain(Connection conn, string sql)
    {
        foreach (block; conn.query(sql))
        {
        }
    }

    void sumNumbers(Connection conn, string sql)
    {
        double total = 0;
        foreach (block; conn.query(sql))
            foreach (v; block.column!UInt64Column("number").data)
                total += v;
        sink = total;
    }

    void columns(Connection conn, string sql)
    {
        double total = 0;
        foreach (block; conn.query(sql))
        {
            foreach (v; block.column!UInt64Column("id").data)
                total += v;
            foreach (s; block.column!StringColumn("name").data)
                total += s.length;
            foreach (v; block.column!Float64Column("value").data)
                total += v;
            foreach (v; block.column!DateTime64Column("ts").data)
                total += v;
        }
        sink = total;
    }

    void structs(Connection conn, string sql)
    {
        double total = 0;
        foreach (row; conn.query!Row(sql))
            total += row.id + row.name.length + row.value + row.ts.stdTime;
        sink = total;
    }

    void getters(Connection conn, string sql)
    {
        double total = 0;
        foreach (block; conn.query(sql))
            foreach (r; 0 .. block.rows)
                total += block.columns[0].getLong(r) + block.columns[1].getString(r)
                    .length
                    + block.columns[2].getDouble(r) + block.columns[3].getSysTime(r).stdTime;
        sink = total;
    }

    cases ~= BenchCase("server/select numbers drain", selectCase(&numbers, &drain), 10_000_000);
    cases ~= BenchCase("server/select numbers columns", selectCase(&numbers, &sumNumbers), 10_000_000);
    cases ~= BenchCase("server/select 4 columns drain", selectCase(&mixedQuery, &drain), 5_000_000);
    cases ~= BenchCase("server/select 4 columns drain lz4", selectCase(&mixedQuery, &drain, Compression.lz4),
            5_000_000);
    if (zstdAvailable)
        cases ~= BenchCase("server/select 4 columns drain zstd", selectCase(&mixedQuery, &drain,
                Compression.zstd), 5_000_000);
    cases ~= BenchCase("server/select 4 columns columns", selectCase(&mixedQuery, &columns), 5_000_000);
    cases ~= BenchCase("server/select 4 columns query!T", selectCase(&mixedQuery, &structs), 5_000_000);
    cases ~= BenchCase("server/select 4 columns per-cell getters", selectCase(&mixedQuery, &getters), 5_000_000);

    // INSERT into a table of `engine`, by `send`
    Prepared delegate(size_t) insertCase(string engine, void delegate(Connection, string, Block[], Row[]) send,
            Compression compression = Compression.none)
    {
        Prepared prepare(size_t rows)
        {
            auto conn = new Connection(serverOptions(compression));
            conn.exec("CREATE DATABASE IF NOT EXISTS clickhoused_bench");
            const table = "clickhoused_bench.insert_" ~ (engine == "Null" ? "null" : "mergetree");
            conn.exec("DROP TABLE IF EXISTS " ~ table);
            conn.exec("CREATE TABLE " ~ table ~ " (id UInt64, name String, value Float64, ts DateTime64(3, 'UTC')) "
                    ~ "ENGINE = " ~ (engine == "Null" ? "Null" : "MergeTree ORDER BY id"));
            auto blocks = makeBlocks(rowSpecs(), rows);
            Row[] all;
            foreach (b; blocks)
                foreach (r; 0 .. b.rows)
                    all ~= Row(b.columns[0].getUlong(r), b.columns[1].getString(r), b.columns[2].getDouble(r),
                            b.columns[3].getSysTime(r));
            void run()
            {
                if (engine != "Null")
                    conn.exec("TRUNCATE TABLE " ~ table); // timed too: small next to the insert
                send(conn, table, blocks, all);
            }

            return Prepared(rows, 0, &run);
        }

        return &prepare;
    }

    void sendBlocks(Connection conn, string table, Block[] blocks, Row[])
    {
        auto ins = conn.beginInsert("INSERT INTO " ~ table ~ " VALUES");
        foreach (b; blocks)
            ins.send(b);
        ins.finish();
    }

    void addRows(Connection conn, string table, Block[], Row[] all)
    {
        auto ins = conn.beginInsert("INSERT INTO " ~ table ~ " VALUES");
        foreach (ref row; all)
            ins.addRow(row.id, row.name, row.value, row.ts);
        ins.finish();
    }

    void insertStructs(Connection conn, string table, Block[], Row[] all)
    {
        conn.insert(table, all);
    }

    enum insertRows = 2_000_000;
    cases ~= BenchCase("server/insert Null blocks", insertCase("Null", &sendBlocks), insertRows);
    cases ~= BenchCase("server/insert Null blocks lz4", insertCase("Null", &sendBlocks, Compression.lz4),
            insertRows);
    cases ~= BenchCase("server/insert Null addRow", insertCase("Null", &addRows), insertRows);
    cases ~= BenchCase("server/insert Null structs", insertCase("Null", &insertStructs), insertRows);
    cases ~= BenchCase("server/insert MergeTree blocks", insertCase("MergeTree", &sendBlocks), insertRows);
    cases ~= BenchCase("server/insert MergeTree addRow", insertCase("MergeTree", &addRows), insertRows);

    // Round trips: `rows` is the number of operations
    Prepared selectOne(size_t count)
    {
        auto conn = new Connection(serverOptions());
        void run()
        {
            double total = 0;
            foreach (_; 0 .. count)
                total += conn.queryValue!ubyte("SELECT 1");
            sink = total;
        }

        return Prepared(count, 0, &run);
    }

    Prepared ping(size_t count)
    {
        auto conn = new Connection(serverOptions());
        void run()
        {
            foreach (_; 0 .. count)
                conn.ping();
        }

        return Prepared(count, 0, &run);
    }

    Prepared poolCycle(size_t count)
    {
        auto pool = new ConnectionPool(serverOptions());
        void run()
        {
            double total = 0;
            foreach (_; 0 .. count)
            {
                total += pool.lockConnection().isOpen; // the temporary is released right away
            }
            sink = total;
        }

        return Prepared(count, 0, &run);
    }

    cases ~= BenchCase("server/latency SELECT 1", &selectOne, 1000);
    cases ~= BenchCase("server/latency ping", &ping, 1000);
    cases ~= BenchCase("server/pool lock and release", &poolCycle, 10_000);
    return cases;
}
